# local.conf — StarFive VisionFive 2 demo image
# Tuned for the build host: Intel Xeon E5-1680 v3 (8c/16t), 125 GB RAM, ~1.2 TB free.
# Yocto series: wrynose (April 2026 LTS). See README.md "Source versions".

# ---------------------------------------------------------------------------
# Target
# ---------------------------------------------------------------------------
MACHINE ?= "visionfive2"
DISTRO ?= "poky"
PACKAGE_CLASSES ?= "package_ipk"

# ---------------------------------------------------------------------------
# Build parallelism (16-thread host — leave headroom for I/O and the UI)
# ---------------------------------------------------------------------------
BB_NUMBER_THREADS ?= "16"
PARALLEL_MAKE ?= "-j 16"

# ---------------------------------------------------------------------------
# Shared download + sstate cache (reused across all boards on this host)
# ---------------------------------------------------------------------------
# Optional: point at a host-wide shared cache to reuse across projects, e.g.
#DL_DIR ?= "/srv/yocto-artifacts/downloads"
#SSTATE_DIR ?= "/srv/yocto-artifacts/sstate-cache"

# ---------------------------------------------------------------------------
# Hash equivalence — the big rebuild accelerator.
# A recipe whose *output* is unchanged (only a trivial metadata/hash change)
# no longer forces every downstream task to rebuild: the local hashserv maps
# the new taskhash back to the existing sstate object. Pairs with the shared
# SSTATE_DIR above. "auto" starts a per-build local hashserv automatically.
# ---------------------------------------------------------------------------
BB_SIGNATURE_HANDLER ?= "OEEquivHash"
BB_HASHSERVE ?= "auto"
# Keep the hash-equivalence DB next to the SHARED sstate, not inside this build
# dir — otherwise sstate can't be reused across builds/boards (bitbake warns).
BB_HASHSERVE_DB_DIR ?= "${SSTATE_DIR}/hashserv"
# OPTIONAL upstream cache — leave commented for a robust first build. The public
# hashserv/sstate mirror can help the many x86_64 *-native tasks, but a slow or
# unreachable endpoint makes bitbake probe-and-404 on every object. Enable only
# after confirming reachability; RISC-V target objects mostly build locally anyway.
# (cache only — never a source of truth; SRCREVs stay pinned.)
#BB_HASHSERVE_UPSTREAM ?= "hashserv.yoctoproject.org:8686"
#SSTATE_MIRRORS ?= "file://.* http://sstate.yoctoproject.org/all/PATH;downloadfilename=PATH \n"

# ---------------------------------------------------------------------------
# Image output formats.
# riscv-common.inc already gives: wic.gz wic.bmap ext4  (SD/eMMC flash path).
# Add tar.gz (extract into the NFS-root export) and cpio.gz (initramfs netboot
# variant) for the TFTP/NFS dev loop — see scripts/netboot.sh, PLAN §6.3.
# ---------------------------------------------------------------------------
IMAGE_FSTYPES:append = " tar.gz cpio.gz"

# ---------------------------------------------------------------------------
# Dev conveniences — REMOVE for a release build.
# NOTE: wrynose removed the "debug-tweaks" meta-feature; use the granular set.
#   empty/allow-empty-password + allow-root-login + serial-autologin-root
#     : passwordless root on serial/netboot dev
#   post-install-logging : capture first-boot postinst output
#   ssh-server-openssh   : on-board validation + the webserver path
# ---------------------------------------------------------------------------
EXTRA_IMAGE_FEATURES ?= "allow-empty-password empty-root-password allow-root-login serial-autologin-root post-install-logging ssh-server-openssh"

# Verification tooling carried in the base image so hardware checks need no rebuild:
#   glmark2/kmscube/mesa-demos -> GPU (renderer string, GBM/KMS path)
#   evtest/libinput            -> touch capture
#   v4l-utils                  -> V4L2/camera enumeration
CORE_IMAGE_EXTRA_INSTALL += "glmark2 kmscube mesa-demos evtest libinput v4l-utils"
# WiFi userspace (ECR6600U cfg80211): scan/associate + DHCP on wlan0.
CORE_IMAGE_EXTRA_INSTALL += "iw wpa-supplicant"

# ---------------------------------------------------------------------------
# Dev-loop ergonomics
# ---------------------------------------------------------------------------
# Keep work dirs (do NOT inherit rm_work): faster incremental rebuilds and
# on-failure debugging. Disk is ample (~1.2 TB).
INHERIT += "rm_work"
RM_WORK_EXCLUDE += "linux-starfive-dev u-boot-starfive mesa-pvr visionfive2-pvr-graphics"
# ^ rm_work ON to keep tmp lean, but EXCLUDE the recipes we iterate on most
#   (kernel/u-boot/GPU) so their work dirs survive for devshell/patch cycles.

# Faster/quieter local builds
BB_DISKMON_DIRS ??= "\
    STOPTASKS,${TMPDIR},2G,100K \
    STOPTASKS,${DL_DIR},2G,100K \
    STOPTASKS,${SSTATE_DIR},2G,100K \
    HALT,${TMPDIR},500M,1K \
    HALT,${DL_DIR},500M,1K \
    HALT,${SSTATE_DIR},500M,1K \
"

# ---------------------------------------------------------------------------
# Licensing — the PowerVR GPU stack (DDK, rgx.fw, pvrsrvkm) is a closed,
# redistributable blob. meta-riscv marks it LICENSE_FLAGS "commercial".
# ---------------------------------------------------------------------------
LICENSE_FLAGS_ACCEPTED ?= "commercial"

# SPDX/SBOM for the closed-blob manifest (R6) — cheap, runs at rootfs time.
INHERIT += "create-spdx"

# ---------------------------------------------------------------------------
# DDK/VPU source redirect (R6/R8).
# meta-riscv wrynose fetches the closed StarFive GPU+VPU userspace (soft_3rdpart)
# from a third-party mirror, git://strlcat.eu/mirroring/jh7110_soft_3rdpart.git,
# which no longer serves that repo (git exit 128). Redirect to the CANONICAL
# StarFive GitHub — the pinned SRCREV b60da16 (tag JH7110_VF2_6.12_v6.0.0) is
# byte-identical there, so this stays fully reproducible while removing the
# dependency on a dead hobby mirror. Covers every recipe that requires
# visionfive2-firmware.inc (pvr-graphics, imggpu firmware, libsf-* VPU).
# ---------------------------------------------------------------------------
PREMIRRORS:append = " \
    git://strlcat.eu/mirroring/jh7110_soft_3rdpart.git git://github.com/starfive-tech/soft_3rdpart.git;protocol=https \n \
"

CONF_VERSION = "2"
# Audio playback tools (PWMDAC/HDMI test) + Bluetooth stack (bluez).
CORE_IMAGE_EXTRA_INSTALL += "alsa-utils bluez5"
