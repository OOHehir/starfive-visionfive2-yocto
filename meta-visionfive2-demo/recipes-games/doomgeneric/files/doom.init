#!/bin/sh
### BEGIN INIT INFO
# Provides:          doom
# Required-Start:    $local_fs $remote_fs
# Required-Stop:     $local_fs $remote_fs
# Default-Start:     5
# Default-Stop:      0 1 6
# Short-Description: Doom (doomgeneric) fullscreen on the DSI framebuffer panel
### END INIT INFO
#
# /dev/fb0 only appears once the DRM fbdev emulation has a connected panel with
# a valid mode (no panel -> no fb0), so this is self-gating. Doom draws straight
# to /dev/fb0, which the Weston compositor otherwise owns, so stop Weston first
# to hand the panel to the game.

NAME=doom
BIN=/usr/bin/doom

case "$1" in
  start)
    [ -e /dev/fb0 ] || { echo "doom: no /dev/fb0 (no panel) - skipping"; exit 0; }
    # hand the display over from Weston to the game
    [ -x /etc/init.d/weston ] && /etc/init.d/weston stop >/dev/null 2>&1
    echo "Starting $NAME on /dev/fb0"
    # 5s grace for USB HID to enumerate (fb backend scans /dev/input once at
    # launch); no keyboard -> attract demo (see the fbdev patch).
    ( sleep 5; exec "$BIN" ) >/dev/null 2>&1 &
    ;;
  stop)
    echo "Stopping $NAME"
    killall doomgeneric 2>/dev/null
    ;;
  restart)
    "$0" stop; "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
exit 0
