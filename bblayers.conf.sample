# Layers are cloned into sources/ (not in git), pinned by SHA in setup-layers.json.
# Recreate with: ./setup-layers --destdir sources

POKY_LAYERS = "${TOPDIR}/../sources"

BBLAYERS ?= " \
  ${POKY_LAYERS}/oe-core/meta \
  ${POKY_LAYERS}/meta-yocto/meta-poky \
  ${POKY_LAYERS}/meta-openembedded/meta-oe \
  ${POKY_LAYERS}/meta-openembedded/meta-python \
  ${POKY_LAYERS}/meta-openembedded/meta-multimedia \
  ${POKY_LAYERS}/meta-riscv \
  ${POKY_LAYERS}/../meta-visionfive2-demo \
"
