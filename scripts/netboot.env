# netboot.env — bench-specific settings for the autonomous dev loop.
# Sourced by scripts/netboot.sh. Everything here is TO-VERIFY on the bench (M0);
# values below are this host's discovered defaults (2026-07-11).

# --- Build ---
VF2_TOP="${VF2_TOP:-$(cd "${here:-$(dirname "$0")}/.." && pwd)}"
VF2_IMAGE="${VF2_IMAGE:-core-image-weston}"
VF2_MACHINE="${VF2_MACHINE:-visionfive2}"
VF2_DEPLOY="${VF2_DEPLOY:-$VF2_TOP/build/tmp/deploy/images/$VF2_MACHINE}"

# --- Artifacts (names per meta-riscv wrynose visionfive2.conf) ---
VF2_KERNEL="${VF2_KERNEL:-Image}"
VF2_DTB="${VF2_DTB:-jh7110-starfive-visionfive-2-v1.3b.dtb}"
VF2_ROOTFS_TAR="${VF2_ROOTFS_TAR:-$VF2_IMAGE-$VF2_MACHINE.rootfs.tar.gz}"
VF2_INITRAMFS="${VF2_INITRAMFS:-$VF2_IMAGE-$VF2_MACHINE.rootfs.cpio.gz}"

# --- TFTP / NFS server (Synology NAS, reached via the CIFS mount from here) ---
# TFTP_LOCAL is where bitbake artifacts are dropped (CIFS mount on this host);
# the board fetches the same files via the NAS's TFTP service at TFTP_SERVERIP.
TFTP_LOCAL="${TFTP_LOCAL:-/media/dsCIFS/public/tftp/visionfive2}"
TFTP_SERVERIP="${TFTP_SERVERIP:-192.168.178.100}"       # Synology ds.local (confirmed)
NFS_EXPORT="${NFS_EXPORT:-/volume1/public/tftp/visionfive2/rootfs}"  # TO-VERIFY
# NB: //ds.local/public is mounted READ-ONLY on the build host — TFTP staging
# needs a writable path (remount rw, or run a local dnsmasq TFTP on 192.168.178.113).
BUILD_HOST_IP="${BUILD_HOST_IP:-192.168.178.113}"

# --- Board serial console ---
SERIAL_DEV="${SERIAL_DEV:-/dev/ttyUSB0}"                 # VF2 debug UART (ttyACM0 = PPK2)
SERIAL_BAUD="${SERIAL_BAUD:-115200}"

# --- Power-cycle (reset half of autonomy) ---
# The PPK2 (Nordic Power Profiler) in SOURCE mode feeds the board and can cut/
# restore DUT power — use the ppk2 MCP tools (ppk2_configure dut_power off/on)
# as the reset. Set POWER_METHOD=manual to prompt for a human power-cycle.
POWER_METHOD="${POWER_METHOD:-ppk2}"                     # ppk2 | manual
PPK2_VOLTAGE_MV="${PPK2_VOLTAGE_MV:-5000}"               # VF2 5V GPIO-header feed
